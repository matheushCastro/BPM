    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const sem = s => String(s).normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\").toLowerCase();\nconst achar = (termos, excluir = []) => {\n  const k = Object.keys($json).find(c =>\n    termos.some(t => sem(c).includes(t)) &&\n    !excluir.some(e => sem(c).includes(e)) &&\n    $json[c] !== \"\" && $json[c] != null\n  );\n  return k ? $json[k] : null;\n};\n\nconst horario = achar([\"horario\"]);\nconst m = String(horario).match(/(\\d{1,2}:\\d{2})\\s*-\\s*(\\d{1,2}:\\d{2})/);\nconst dataBr = achar([\"data\"], [\"carimbo\"]);\nconst [d, mes, a] = String(dataBr).split(\"/\");\nconst data = `${a}-${String(mes).padStart(2, \"0\")}-${String(d).padStart(2, \"0\")}`;\n\nreturn { json: {\n  nome: achar([\"nome\"]),\n  email: achar([\"mail\"]),\n  sala: achar([\"sala\", \"laboratorio\"]),\n  data_br: dataBr,\n  data,\n  dia_semana: new Date(data + \"T12:00:00\").getDay(),\n  inicio: m ? m[1].padStart(5, \"0\") + \":00\" : null,\n  fim: m ? m[2].padStart(5, \"0\") + \":00\" : null,\n  motivo: $json[\"Motivo da reserva\"] || $json[\"Motivo da Reserva\"] || achar([\"motivo\", \"opcoes\"])\n}};"
      },
