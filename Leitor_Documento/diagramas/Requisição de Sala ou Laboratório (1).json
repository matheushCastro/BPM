        "query": "INSERT INTO reservas (sala_pretendida, data_reserva, horario, horario_inicio, horario_fim, nome_solicitante, status, motivo)\nVALUES (\n  '{{ $('Normalizar').item.json.sala }}',\n  '{{ $('Normalizar').item.json.data }}',\n  '{{ $('Normalizar').item.json.inicio }}',\n  '{{ $('Normalizar').item.json.inicio }}',\n  '{{ $('Normalizar').item.json.fim }}',\n  '{{ ($('Normalizar').item.json.nome || \"\").replace(/'/g, \"''\") }}',\n  'solicitado',\n  '{{ ($('Normalizar').item.json.motivo || \"\").replace(/'/g, \"''\") }}'\n);",
