<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Reserva de Sala ou Laboratório" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Reserva de Sala ou Laboratório" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Solicitante">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Secretaria">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fimIndisponivel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fimNegado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Coordenador">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Técnico de laboratório">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fimConcluido</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Início da solicitação">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Preencher formulário de requisição">
      <bpmn:documentation>Responsável: Solicitante</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t2" name="Verificar disponibilidade do espaço na agenda">
      <bpmn:documentation>Responsável: Secretaria</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Espaço disponível?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t3" name="Informar solicitante sobre a indisponibilidade">
      <bpmn:documentation>Responsável: Secretaria</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="fimIndisponivel" name="Encerrado por indisponibilidade">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t4" name="Encaminhar requisição ao coordenador">
      <bpmn:documentation>Responsável: Secretaria</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t5" name="Analisar requisição">
      <bpmn:documentation>Responsável: Coordenador</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Requisição aprovada?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t6" name="Informar negativa ao solicitante">
      <bpmn:documentation>Responsável: Secretaria</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="fimNegado" name="Encerrado por recusa">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t7" name="Registrar reserva na agenda e enviar confirmação">
      <bpmn:documentation>Responsável: Secretaria</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t8" name="Preparar o espaço e liberar a chave">
      <bpmn:documentation>Responsável: Técnico de laboratório</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="fimConcluido" name="Reserva concluída">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="inicio" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="g1" targetRef="t3" name="Não" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="t3" targetRef="fimIndisponivel" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="g1" targetRef="t4" name="Sim" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="t5" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="g2" targetRef="t6" name="Não" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="t6" targetRef="fimNegado" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="g2" targetRef="t7" name="Sim" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="t8" targetRef="fimConcluido" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="2130" height="630" />
