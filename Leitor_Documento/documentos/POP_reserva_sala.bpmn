<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_1" name="POP_reserva_sala" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="POP_reserva_sala" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Atividades">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Etapa_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Etapa_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Etapa_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Etapa_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Etapa_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Etapa_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Início">
      <bpmn:outgoing>F_Inicio_Etapa_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Etapa_1" name="O solicitante preenche o formulário">
      <bpmn:documentation>O solicitante preenche o formulário de requisição informando o espaço desejado, a data, o horário e a finalidade de uso.</bpmn:documentation>
      <bpmn:incoming>F_Inicio_Etapa_1</bpmn:incoming>
      <bpmn:outgoing>F_Etapa_1_Etapa_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Etapa_2" name="A secretaria recebe a requisição">
      <bpmn:documentation>A secretaria recebe a requisição e verifica na agenda se o espaço está disponível na data e no horário pedidos.</bpmn:documentation>
      <bpmn:incoming>F_Etapa_1_Etapa_2</bpmn:incoming>
      <bpmn:outgoing>F_Etapa_2_Etapa_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Etapa_3" name="Se o espaço estiver indisponível">
      <bpmn:documentation>Se o espaço estiver indisponível, a secretaria informa o solicitante sobre a indisponibilidade e o processo é encerrado.</bpmn:documentation>
      <bpmn:incoming>F_Etapa_2_Etapa_3</bpmn:incoming>
      <bpmn:outgoing>F_Etapa_3_Etapa_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Etapa_4" name="Se o espaço estiver disponível">
      <bpmn:documentation>Se o espaço estiver disponível, a secretaria encaminha a requisição ao coordenador para aprovação.</bpmn:documentation>
      <bpmn:incoming>F_Etapa_3_Etapa_4</bpmn:incoming>
      <bpmn:outgoing>F_Etapa_4_Etapa_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Etapa_5" name="O coordenador analisa a requisição">
      <bpmn:documentation>O coordenador analisa a requisição. Se aprovar, a secretaria registra a reserva na agenda e envia a confirmação ao solicitante. Se negar, a secretaria informa o solicitante e o processo é encerrado.</bpmn:documentation>
      <bpmn:incoming>F_Etapa_4_Etapa_5</bpmn:incoming>
      <bpmn:outgoing>F_Etapa_5_Etapa_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Etapa_6" name="No dia da reserva">
      <bpmn:documentation>No dia da reserva, o técnico de laboratório prepara o espaço e libera a chave ao solicitante. O processo termina com a reserva concluída.</bpmn:documentation>
      <bpmn:incoming>F_Etapa_5_Etapa_6</bpmn:incoming>
      <bpmn:outgoing>F_Etapa_6_Fim</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Fim" name="Fim">
      <bpmn:incoming>F_Etapa_6_Fim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Inicio_Etapa_1" sourceRef="Inicio" targetRef="Etapa_1" />
    <bpmn:sequenceFlow id="F_Etapa_1_Etapa_2" sourceRef="Etapa_1" targetRef="Etapa_2" />
    <bpmn:sequenceFlow id="F_Etapa_2_Etapa_3" sourceRef="Etapa_2" targetRef="Etapa_3" />
    <bpmn:sequenceFlow id="F_Etapa_3_Etapa_4" sourceRef="Etapa_3" targetRef="Etapa_4" />
    <bpmn:sequenceFlow id="F_Etapa_4_Etapa_5" sourceRef="Etapa_4" targetRef="Etapa_5" />
    <bpmn:sequenceFlow id="F_Etapa_5_Etapa_6" sourceRef="Etapa_5" targetRef="Etapa_6" />
    <bpmn:sequenceFlow id="F_Etapa_6_Fim" sourceRef="Etapa_6" targetRef="Fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_1">
    <bpmndi:BPMNPlane id="P_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="S_Pool_1" bpmnElement="Pool_1" isHorizontal="true">
        <dc:Bounds x="160" y="110" width="1312" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_1" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="190" y="110" width="1282" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Inicio" bpmnElement="Inicio">
        <dc:Bounds x="280" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="285" y="228" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Etapa_1" bpmnElement="Etapa_1">
        <dc:Bounds x="366" y="170" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Etapa_2" bpmnElement="Etapa_2">
        <dc:Bounds x="536" y="170" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Etapa_3" bpmnElement="Etapa_3">
        <dc:Bounds x="706" y="170" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Etapa_4" bpmnElement="Etapa_4">
        <dc:Bounds x="876" y="170" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Etapa_5" bpmnElement="Etapa_5">
        <dc:Bounds x="1046" y="170" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Etapa_6" bpmnElement="Etapa_6">
        <dc:Bounds x="1216" y="170" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Fim" bpmnElement="Fim">
        <dc:Bounds x="1386" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1395" y="228" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_F_Inicio_Etapa_1" bpmnElement="F_Inicio_Etapa_1">
        <di:waypoint x="316" y="210" />
        <di:waypoint x="366" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_Etapa_1_Etapa_2" bpmnElement="F_Etapa_1_Etapa_2">
        <di:waypoint x="486" y="210" />
        <di:waypoint x="536" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_Etapa_2_Etapa_3" bpmnElement="F_Etapa_2_Etapa_3">
        <di:waypoint x="656" y="210" />
        <di:waypoint x="706" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_Etapa_3_Etapa_4" bpmnElement="F_Etapa_3_Etapa_4">
        <di:waypoint x="826" y="210" />
        <di:waypoint x="876" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_Etapa_4_Etapa_5" bpmnElement="F_Etapa_4_Etapa_5">
        <di:waypoint x="996" y="210" />
        <di:waypoint x="1046" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_Etapa_5_Etapa_6" bpmnElement="F_Etapa_5_Etapa_6">
        <di:waypoint x="1166" y="210" />
        <di:waypoint x="1216" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_Etapa_6_Fim" bpmnElement="F_Etapa_6_Fim">
        <di:waypoint x="1336" y="210" />
        <di:waypoint x="1386" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
