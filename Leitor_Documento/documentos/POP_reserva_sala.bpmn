<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="BPMN Modeler" exporterVersion="1.0">
  <collaboration id="Collaboration_1">
    <participant id="Participant_Process" name="Reserva de Sala ou Laboratório" processRef="Process_1" />
  </collaboration>
  <process id="Process_1" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_Solicitante" name="Solicitante">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Activity_Informa_Solicitante1</flowNodeRef>
        <flowNodeRef>Activity_Informa_Solicitante2</flowNodeRef>
        <flowNodeRef>Activity_Recebe_Chave</flowNodeRef>
        <flowNodeRef>EndEvent_Indisponivel</flowNodeRef>
        <flowNodeRef>EndEvent_Negado</flowNodeRef>
        <flowNodeRef>EndEvent_Concluido</flowNodeRef>
      </lane>
      <lane id="Lane_Secretaria" name="Secretaria">
        <flowNodeRef>Activity_Preenche_Formulario</flowNodeRef>
        <flowNodeRef>Activity_Verifica_Agenda</flowNodeRef>
        <flowNodeRef>Gateway_Disponivel</flowNodeRef>
        <flowNodeRef>Activity_Encaminha_Coordenador</flowNodeRef>
        <flowNodeRef>Activity_Registra_Reserva</flowNodeRef>
        <flowNodeRef>Activity_Envia_Confirmacao</flowNodeRef>
      </lane>
      <lane id="Lane_Coordenador" name="Coordenador">
        <flowNodeRef>Activity_Analisa_Requisicao</flowNodeRef>
        <flowNodeRef>Gateway_Aprova</flowNodeRef>
      </lane>
      <lane id="Lane_Tecnico" name="Técnico de laboratório">
        <flowNodeRef>Activity_Prepara_Espaco</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="StartEvent_1" name="Início da Reserva">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <userTask id="Activity_Preenche_Formulario" name="Preencher formulário requisição">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </userTask>
    <userTask id="Activity_Verifica_Agenda" name="Verificar agenda espaço">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </userTask>
    <exclusiveGateway id="Gateway_Disponivel" name="Espaço disponível?">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_Sim1</outgoing>
      <outgoing>Flow_Nao1</outgoing>
    </exclusiveGateway>
    <sendTask id="Activity_Informa_Solicitante1" name="Informar solicitante indisponibilidade">
      <incoming>Flow_Nao1</incoming>
      <outgoing>Flow_End1</outgoing>
    </sendTask>
    <userTask id="Activity_Encaminha_Coordenador" name="Encaminhar requisição coordenador">
      <incoming>Flow_Sim1</incoming>
      <outgoing>Flow_4</outgoing>
    </userTask>
    <userTask id="Activity_Analisa_Requisicao" name="Analisar requisição">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
    </userTask>
    <exclusiveGateway id="Gateway_Aprova" name="Aprovar requisição?">
      <incoming>Flow_5</incoming>
      <outgoing>Flow_Sim2</outgoing>
      <outgoing>Flow_Nao2</outgoing>
    </exclusiveGateway>
    <sendTask id="Activity_Informa_Solicitante2" name="Informar solicitante recusa">
      <incoming>Flow_Nao2</incoming>
      <outgoing>Flow_End2</outgoing>
    </sendTask>
    <userTask id="Activity_Registra_Reserva" name="Registrar reserva agenda">
      <incoming>Flow_Sim2</incoming>
      <outgoing>Flow_6</outgoing>
    </userTask>
    <sendTask id="Activity_Envia_Confirmacao" name="Enviar confirmação solicitante">
      <incoming>Flow_6</incoming>
      <outgoing>Flow_7</outgoing>
    </sendTask>
    <userTask id="Activity_Prepara_Espaco" name="Preparar espaço">
      <incoming>Flow_7</incoming>
      <outgoing>Flow_8</outgoing>
    </userTask>
    <userTask id="Activity_Recebe_Chave" name="Receber chave espaço">
      <incoming>Flow_8</incoming>
      <outgoing>Flow_End3</outgoing>
    </userTask>
    <endEvent id="EndEvent_Indisponivel" name="Reserva Indisponível">
      <incoming>Flow_End1</incoming>
    </endEvent>
    <endEvent id="EndEvent_Negado" name="Reserva Negada">
      <incoming>Flow_End2</incoming>
    </endEvent>
    <endEvent id="EndEvent_Concluido" name="Reserva Concluída">
      <incoming>Flow_End3</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_Preenche_Formulario" />
    <sequenceFlow id="Flow_2" sourceRef="Activity_Preenche_Formulario" targetRef="Activity_Verifica_Agenda" />
    <sequenceFlow id="Flow_3" sourceRef="Activity_Verifica_Agenda" targetRef="Gateway_Disponivel" />
    <sequenceFlow id="Flow_Sim1" name="Sim" sourceRef="Gateway_Disponivel" targetRef="Activity_Encaminha_Coordenador" />
    <sequenceFlow id="Flow_Nao1" name="Não" sourceRef="Gateway_Disponivel" targetRef="Activity_Informa_Solicitante1" />
    <sequenceFlow id="Flow_End1" sourceRef="Activity_Informa_Solicitante1" targetRef="EndEvent_Indisponivel" />
    <sequenceFlow id="Flow_4" sourceRef="Activity_Encaminha_Coordenador" targetRef="Activity_Analisa_Requisicao" />
    <sequenceFlow id="Flow_5" sourceRef="Activity_Analisa_Requisicao" targetRef="Gateway_Aprova" />
    <sequenceFlow id="Flow_Sim2" name="Sim" sourceRef="Gateway_Aprova" targetRef="Activity_Registra_Reserva" />
    <sequenceFlow id="Flow_Nao2" name="Não" sourceRef="Gateway_Aprova" targetRef="Activity_Informa_Solicitante2" />
    <sequenceFlow id="Flow_End2" sourceRef="Activity_Informa_Solicitante2" targetRef="EndEvent_Negado" />
    <sequenceFlow id="Flow_6" sourceRef="Activity_Registra_Reserva" targetRef="Activity_Envia_Confirmacao" />
    <sequenceFlow id="Flow_7" sourceRef="Activity_Envia_Confirmacao" targetRef="Activity_Prepara_Espaco" />
    <sequenceFlow id="Flow_8" sourceRef="Activity_Prepara_Espaco" targetRef="Activity_Recebe_Chave" />
    <sequenceFlow id="Flow_End3" sourceRef="Activity_Recebe_Chave" targetRef="EndEvent_Concluido" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
